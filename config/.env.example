# Aurora — Environment Variables
#
# Copy this file to ~/.config/opencode/.env and fill in your values.
# The setup.sh script can do this automatically for you.
#
# This file is a template — it contains NO secrets.
# The real .env file must NEVER be committed to the repository.

# ─── Required ───────────────────────────────────────────────────────────────

# Your Infomaniak AI API key (found in the Infomaniak console)
#
# IMPORTANT: this key is NOT stored in .env. It has a single copy: an export
# line in your shell rc (~/.zshrc, managed block written by setup.sh) and it
# is read by opencode.json via {env:OPENAI_API_KEY_INFOMANIAK} — OpenCode does
# NOT load .env files into its process environment.
# Update the key with: setup.sh --force
# NOTE: This is separate from OPENAI_API_KEY to avoid collisions with
#       other OpenAI-compatible providers. Do NOT use OPENAI_API_KEY for Infomaniak.

# NOTE: The Infomaniak AI endpoints are set directly in opencode.json
#   - https://api.infomaniak.com/2/ai/private/openai/v1   (standard, public API)
#   - direct model endpoints follow the public AI API docs (host set in the
#     live config only — never documented in this public repo)
# They no longer come from environment variables.

# NOTE: IDB_UDID and IDB_PATH (iOS Simulator MCP) are also NOT stored here.
# They are exported in the managed shell rc block next to the API key, because
# the ios-simulator MCP reads its process environment only (no .env fallback).
# setup.sh asks for them and writes the block automatically.

# Infomaniak API token (for the Infomaniak MCP server)
# Get your token at: https://manager.infomaniak.com/v3/ng/accounts/token/list
# Required by the infomaniak MCP server (events, profile, accounts, AI, VOD, newsletter, DNS, etc.)
# NOTE: opencode.json also passes {env:INFOMANIAK_API_TOKEN}, but the MCP reads
#       this .env file as a fallback — so keeping it here works.
INFOMANIAK_API_TOKEN=

# GitLab token (for the Angular Elements MCP server)
# Required by the angular-elements MCP server (component docs, API, stories, install info)
# Create a Personal Access Token in your GitLab instance:
#   https://<your-gitlab-host>/-/profile/personal_access_tokens
GITLAB_TOKEN=

# Angular Elements MCP — target project and Storybook index.
# No defaults are hard-coded in the MCP; it fails with an explicit error if
# these are missing (see mcp/angular-elements/README.md).
ANGULAR_ELEMENTS_GITLAB_API=
ANGULAR_ELEMENTS_PROJECT_ID=
ANGULAR_ELEMENTS_STORYBOOK_BASE=
ANGULAR_ELEMENTS_REF=master

# Figma token (for the figma-ds MCP server / design system sync CLI)
# Required by the figma-ds tooling (design system snapshots & sync).
# Create a Personal Access Token at: https://www.figma.com/settings → Security → Personal access tokens
# Scopes: file_content:read, file_metadata:read, library_content:read (+ file_variables:read if available on your plan)
FIGMA_TOKEN=
