# Serveur mémoire aurora-memory — configuration locale (copier vers .env et adapter).
#
# Emplacements lus par le serveur, par priorité :
#   1. l'environnement du processus OpenCode (variables déjà exportées)
#   2. .env à la racine du clone opencode-config   ← LE fichier que lit le bundle
#      (dotenv 3-niveaux au-dessus de dist/index.mjs)
#
# ⚠️ Jamais de secret versionné : .env est git-ignoré.

# ── Obligatoire ─────────────────────────────────────────────────────────────
# Base mémoire personnelle (PostgreSQL + pgvector, provisionnée par
# scripts/setup-memory.sh ou le compose de infra/).
DATABASE_URL=postgresql://aurora:aurora@127.0.0.1:5433/aurora

# ── Compose (infra/docker-compose.yml) ────────────────────────────────────────
# Ces variables ne sont lues par docker compose QUE si vous les exportez ou
# passez --env-file ; sinon les défauts du compose s'appliquent (aurora/aurora,
# port 5433). Si vous les personnalisez, adaptez DATABASE_URL en conséquence.
POSTGRES_USER=aurora
POSTGRES_PASSWORD=aurora
POSTGRES_DB=aurora
POSTGRES_PORT=5433

# ── Optionnel : embeddings (recherche sémantique) ────────────────────────────
# Sans ces variables, tout fonctionne SAUF la recherche sémantique
# (memory_search en mode dégradé). Aucune clé requise pour le reste.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=4096

# ── Optionnel ────────────────────────────────────────────────────────────────
# Racine de projection (écritures docs/ai/projection/ — additif). Défaut : désactivé.
AURORA_PROJECTION_ROOT=
# URL d'une base de TEST distincte (jamais la base mémoire réelle).
TEST_DATABASE_URL=
