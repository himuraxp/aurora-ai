{
  "account": {
    "host": "mail.infomaniak.com",
    "port": 993,
    "login_env": "MAIL_TRIAGE_IMAP_LOGIN",
    "password_env": "MAIL_TRIAGE_IMAP_PASSWORD"
  },
  "source": {
    "mailbox": "INBOX"
  },
  "destinations": {
    "allowlist": [
      "INBOX/Auto/Newsletters",
      "INBOX/Auto/Notifications",
      "INBOX/Tri/Exemple",
      "INBOX/Tri/JIRA - Trello - Redmine"
    ]
  },
  "writes": {
    "enabled": true,
    "imap_enabled": true,
    "digest_enabled": true
  },
  "digest": {
    "enabled": true,
    "lookback_hours": 18,
    "always_inbox_cap": 10,
    "min_interval_hours": 20,
    "scan_recent_uid_window": 300,
    "timezone": "Europe/Paris",
    "sensitive_subject_patterns": ["(?i)contrat", "(?i)salaire", "(?i)mot de passe"]
  },
  "kchat": {
    "base_url": "https://infomaniak.kchat.infomaniak.com/api/v4",
    "token_env": "MAIL_TRIAGE_KCHAT_TOKEN",
    "dm_username_env": "MAIL_TRIAGE_KCHAT_DM_USERNAME",
    "timeout_seconds": 15
  },
  "plan": {
    "expire_hours": 24
  }
}
